# Copia in .env e adatta. Nessun segreto e necessario per le fonti attive:
# OpenRouter, models.dev, SWE-bench e Aider sono API pubbliche non autenticate.

PORT=8031
LOG_LEVEL=info

# Orario dell aggiornamento quotidiano (fuso documentato: Europe/Rome).
MODELPICK_TZ=Europe/Rome
MODELPICK_RUN_HOUR=6
MODELPICK_RUN_MINUTE=30

# Fonti: attiva una fonte solo dopo aver letto le sue condizioni di riuso.
SOURCE_OPENROUTER=true
SOURCE_MODELSDEV=true
SOURCE_SWEBENCH=true
SOURCE_AIDER=true
SOURCE_ARTIFICIALANALYSIS=false
SOURCE_PRICEPERTOKEN=false
SOURCE_CHEAPERINFERENCE=false

# Commissione OpenRouter sull acquisto dei crediti, in punti percentuali.
# Lasciala vuota se non l hai verificata: il sito la dichiarera come
# "non quantificata" invece di stimarla.
# OPENROUTER_CREDIT_FEE_PERCENT=

# Soglie (i valori predefiniti sono documentati su /metodo).
# MODELPICK_OFFER_STALE_HOURS=48
# MODELPICK_EVIDENCE_STALE_DAYS=270
