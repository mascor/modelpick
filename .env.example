# Copy to .env and adapt. Only secret: AA_API_KEY for Artificial Analysis,
# the primary quality source. The other active sources are public APIs.

PORT=8031
LOG_LEVEL=info

# Time of the daily update (time zone is documented: Europe/Rome).
MODELPICK_TZ=Europe/Rome
MODELPICK_RUN_HOUR=6
MODELPICK_RUN_MINUTE=30

# Sources: enable one only after reading its reuse terms in full.
SOURCE_OPENROUTER=true
SOURCE_MODELSDEV=true
SOURCE_SWEBENCH=false
SOURCE_AIDER=false
SOURCE_ARTIFICIALANALYSIS=true
# OpenCode usage statistics (opencode.ai/data): breaks near-ties between scores.
SOURCE_OPENCODEDATA=true
SOURCE_PRICEPERTOKEN=false
SOURCE_CHEAPERINFERENCE=false

# OpenRouter fee on buying credits, in percentage points. Declared in their FAQ
# (https://openrouter.ai/docs/faq): 5.5% with a 0.80 USD minimum per purchase by
# card, 5% by crypto. Leave it empty if you have not verified it yourself: the
# site then declares the fee as "not quantified" instead of estimating it.
OPENROUTER_CREDIT_FEE_PERCENT=5.5

# Thresholds (the defaults are documented at /en/method).
# MODELPICK_OFFER_STALE_HOURS=48
# MODELPICK_EVIDENCE_MAX_DAYS=7
# MODELPICK_EVIDENCE_FRESH_DAYS=2
# MODELPICK_AA_CACHE_HOURS=20

# Artificial Analysis: private key (free tier), never goes into the repository.
AA_API_KEY=
